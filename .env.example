# Copy this file to .env and fill in one key. .env is ignored by git.

# groq (default), gemini or openai
LLM_PROVIDER=groq

GROQ_API_KEY=
GEMINI_API_KEY=
# Also used for embeddings in the retrieval baseline of the scaling eval
OPENAI_API_KEY=

# Optional: override the provider's default model
# LLM_MODEL=

# Only for `python chat.py --live` (PayPal sandbox app credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Optional: also send traces to LangSmith
LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=multi-tool-agent

# Optional: Jev chooses the tool; the LLM above becomes its fallback
JEV_API_KEY=
# JEV_MODEL=jev-1.14.0
